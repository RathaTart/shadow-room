{
  "camera": { "text": "Use webcam (your shadow)", "type": "checkbox", "value": true },
  "demo": { "text": "Demo figure instead of webcam", "type": "checkbox", "value": false },
  "hallIntensity": { "text": "Shadow light", "type": "slider", "value": 1.0, "min": 0.2, "max": 2.0, "step": 0.05 },
  "shadowSoftness": { "text": "Shadow softness", "type": "slider", "value": 1.0, "min": 0.0, "max": 3.0, "step": 0.05 },
  "shadowReach": { "text": "Shadow travel when you move", "type": "slider", "value": 1.0, "min": 0.3, "max": 2.5, "step": 0.05 },
  "interactions": { "text": "Objects react to your shadow", "type": "checkbox", "value": true },
  "parallax": { "text": "Head-tracked 3D parallax", "type": "slider", "value": 1.0, "min": 0.0, "max": 2.5, "step": 0.05 },
  "headTurn": { "text": "Head turn sensitivity (0 = off)", "type": "slider", "value": 1.5, "min": 0.0, "max": 3.0, "step": 0.05 },
  "lookAll": { "text": "Look all around: behind you, up and down", "type": "checkbox", "value": true },
  "cat": { "text": "Cat", "type": "checkbox", "value": true },
  "autoCenter": { "text": "Auto-center head tracking", "type": "checkbox", "value": true },
  "recenter": { "text": "Center: this is my normal head position (then look at the screen)", "type": "button", "value": "Center" },
  "mirror": { "text": "Mirror webcam", "type": "checkbox", "value": true },
  "webcamFov": { "text": "Webcam field of view (degrees)", "type": "slider", "value": 62, "min": 45, "max": 100, "step": 1 },
  "roomLight": { "text": "Ceiling lamp on", "type": "checkbox", "value": true },
  "roomIntensity": { "text": "Ceiling lamp brightness", "type": "slider", "value": 1.0, "min": 0.0, "max": 3.0, "step": 0.05 },
  "moon": { "text": "Moonlight", "type": "checkbox", "value": true },
  "exposure": { "text": "Exposure", "type": "slider", "value": 0.85, "min": 0.3, "max": 2.0, "step": 0.01 },
  "dust": { "text": "Dust in the light beam", "type": "checkbox", "value": true },
  "bloom": { "text": "Bloom", "type": "checkbox", "value": true },
  "grain": { "text": "Film grain", "type": "checkbox", "value": true },
  "quality": { "text": "Quality (reloads)", "type": "dropdown", "value": 1, "items": ["Low", "Medium", "High"] },
  "fpsCap": { "text": "Frame rate cap", "type": "dropdown", "value": 1, "items": ["24", "30", "60"] },
  "showTracking": { "text": "Show tracking view (top right): what the webcam sees + timings", "type": "checkbox", "value": false }
}
